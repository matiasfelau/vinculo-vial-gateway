# ─────────────────────────────────────────────────────────────────────────────
# vinculo-vial-gateway — copiar a `.env` y completar. `.env` NO se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# ── Puertos publicados en el host ────────────────────────────────────────────
# Proxy: único punto de entrada público de la plataforma.
GATEWAY_PROXY_PORT=8000
# Admin API: sólo se publica en 127.0.0.1 (healthcheck / debug local).
GATEWAY_ADMIN_PORT=8001

# ── Runtime de Kong ──────────────────────────────────────────────────────────
# notice | info | debug — `debug` sólo en desarrollo.
KONG_LOG_LEVEL=notice

# ── Seguridad perimetral ─────────────────────────────────────────────────────
# Secreto compartido con la app móvil, que firma el Mock App Attestation
# (HMAC-SHA256) y que el Gateway valida. Mismo valor en ambos repos.
# Generar uno propio por entorno, mínimo 16 bytes:
#   openssl rand -hex 32
APP_ATTESTATION_PSK=cambiame-por-un-secreto-generado-con-openssl-rand-hex-32
# Vida máxima aceptada del token de atestación, medida desde su `iat`.
# Acota la ventana de replay aunque la app emita un `exp` más generoso.
ATTESTATION_TOKEN_TTL_SECONDS=300

# Rate limiting global por IP de cliente (plugin nativo `rate-limiting`).
# Aplica a toda la plataforma, no sólo a signup.
RATE_LIMIT_PER_MINUTE=60

# ── Token Offloading ─────────────────────────────────────────────────────────
# Clave pública RSA de vinculo-vial-identity, con la que el Gateway verifica la
# firma RS256 de los JWT de sesión. Los saltos de línea van escapados como \n:
# el valor se inserta en un escalar YAML entrecomillado, que los interpreta.
# Para convertir un PEM a este formato:
#   awk 'BEGIN{ORS="\\n"} 1' identity-public.pem
# El valor de abajo es sólo un ejemplo para que el stack levante: reemplazar
# por la clave pública real de Identity.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAv86OLSaF1D2PGjRpk7ek\nGpPKXDpCCoQFrntN0tYywgjucgGy55hV+L/NioGhiBsheUmyoFfRlXzwt6e+WZzn\nTMlx+8poRwjyYI+z7QkMtwgRV+NLhOuoF23rxfr+lsOwFy2PLTvXtcEOIB59SH+u\nLhWDU4+7qwD3tCT1H2JMay8XaIDDcTPZiPFqVKV5oFfoP+0HBpjE5ObAzoraGBbH\nUanI9qo5vrvEKL0zbycbJ+cVsXOJc8y7eUcXnAruKPsOOkmnTdBnC61P1I2kXy3t\nRk2EIVVdGvCJsDm7E9/No5LA5UwL7toUTpRFAnSWW9jcFf49pc0pKwYOUgZpuoNE\nowIDAQAB\n-----END PUBLIC KEY-----
# Valor del claim `iss` de los JWT emitidos por Identity. Es la clave con la
# que Kong ubica el credencial del consumer.
JWT_ISSUER=vinculo-vial-identity

# ── Upstreams ────────────────────────────────────────────────────────────────
# URL interna de vinculo-vial-identity. El nombre de host es el del servicio en
# la red Docker compartida de la plataforma.
IDENTITY_SERVICE_URL=http://vinculo-vial-identity:8080
