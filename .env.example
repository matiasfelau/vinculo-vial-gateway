# ─────────────────────────────────────────────────────────────────────────────
# vinculo-vial-gateway — copiar a `.env` y completar. `.env` NO se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# ── Puertos publicados en el host ────────────────────────────────────────────
# Proxy: único punto de entrada público de la plataforma.
GATEWAY_PROXY_PORT=8000
# Admin API: sólo se publica en 127.0.0.1 (healthcheck / debug local).
GATEWAY_ADMIN_PORT=8001

# ── Runtime de Kong ──────────────────────────────────────────────────────────
# notice | info | debug — `debug` sólo en desarrollo.
KONG_LOG_LEVEL=notice

# ── Seguridad perimetral ─────────────────────────────────────────────────────
# Secreto compartido con la app móvil, que firma el Mock App Attestation
# (HMAC-SHA256) y que el Gateway valida. Mismo valor en ambos repos.
# Generar uno propio por entorno, mínimo 16 bytes:
#   openssl rand -hex 32
APP_ATTESTATION_PSK=cambiame-por-un-secreto-generado-con-openssl-rand-hex-32
# Vida máxima aceptada del token de atestación, medida desde su `iat`.
# Acota la ventana de replay aunque la app emita un `exp` más generoso.
ATTESTATION_TOKEN_TTL_SECONDS=300

# Rate limiting global por IP de cliente (plugin nativo `rate-limiting`).
# Aplica a toda la plataforma, no sólo a signup.
RATE_LIMIT_PER_MINUTE=60

# ── Upstreams ────────────────────────────────────────────────────────────────
# URL interna de vinculo-vial-identity. El nombre de host es el del servicio en
# la red Docker compartida de la plataforma.
IDENTITY_SERVICE_URL=http://vinculo-vial-identity:8080
