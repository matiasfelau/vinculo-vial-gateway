# ─────────────────────────────────────────────────────────────────────────────
# vinculo-vial-gateway — copiar a `.env` y completar. `.env` NO se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# ── Puertos publicados en el host ────────────────────────────────────────────
# Proxy: único punto de entrada público de la plataforma.
GATEWAY_PROXY_PORT=8000
# Status API (sólo lectura): se publica sólo en 127.0.0.1. La Admin API está
# apagada: en DB-less no cumple ninguna función.
GATEWAY_STATUS_PORT=8100

# ── Runtime de Kong ──────────────────────────────────────────────────────────
# notice | info | debug — `debug` sólo en desarrollo.
KONG_LOG_LEVEL=notice

# Proxies de confianza, si el Gateway queda detrás de un balanceador o ingress.
# Vacío = el Gateway está expuesto directamente y se ignora cualquier
# `X-Forwarded-For` que mande el cliente, para que no pueda falsear su IP y
# evadir el rate limiting. Si hay un proxy adelante, poner acá su CIDR
# (ej. `10.0.0.0/8`) o el tráfico entero compartiría un único contador.
KONG_TRUSTED_IPS=

# ── Atestación (Google Play Integrity) ───────────────────────────────────────
# `google` = producción: el Gateway canjea el token opaco del dispositivo en
# la API de Google. `mock` = CI y desarrollo sin dispositivo físico, con un
# veredicto firmado con PSK que tiene la misma forma anidada que el real.
# NUNCA `mock` en producción: quien tenga la PSK fabrica cualquier veredicto.
ATTESTATION_SOURCE=google

# Package name de la app en Play Console. Se verifica contra el veredicto, así
# que un token emitido para otra app no sirve acá.
PLAY_PACKAGE_NAME=ar.vinculovial.app

# JSON del service account de Google Cloud con permiso sobre la Play Integrity
# API. Se monta como archivo (ver docker-compose.yml) en vez de pasarse por
# entorno: así la clave privada no queda en el ambiente del proceso ni en la
# configuración declarativa. El archivo va en ./secrets/, que no se versiona.
GOOGLE_SERVICE_ACCOUNT_PATH=/etc/vinculo-vial/google-service-account.json

# Endpoint de la Play Integrity API. Sólo se cambia para apuntar a un stub en
# los tests de integración; contra Google real va el valor de abajo y
# ATTESTATION_SSL_VERIFY tiene que quedar en `true`.
PLAY_INTEGRITY_URL=https://playintegrity.googleapis.com
ATTESTATION_SSL_VERIFY=true

# Veredictos de dispositivo aceptados (alcanza con que el dispositivo reporte
# uno). Los niveles de Google son acumulativos:
#   MEETS_STRONG_INTEGRITY   respaldo por hardware
#   MEETS_DEVICE_INTEGRITY   dispositivo Android certificado por Google
#   MEETS_BASIC_INTEGRITY    controles básicos; PUEDE ESTAR ROOTEADO
#   MEETS_VIRTUAL_INTEGRITY  emulador con Play Services
# Agregar los dos últimos afloja el control de forma deliberada.
ATTESTATION_DEVICE_VERDICTS=["MEETS_DEVICE_INTEGRITY","MEETS_STRONG_INTEGRITY"]

# Vida máxima aceptada de la atestación, medida desde el `timestampMillis` que
# emite Google (su reloj, no el del dispositivo).
ATTESTATION_MAX_AGE_SECONDS=120

# Cómo codifica el Frontend el SHA-256 del body en `setRequestHash()`.
# hex | base64 | base64url — tiene que coincidir exactamente con el Frontend.
ATTESTATION_REQUEST_HASH_ENCODING=hex

# Sólo para ATTESTATION_SOURCE=mock. Secreto compartido con el emisor del mock.
#   openssl rand -hex 32
APP_ATTESTATION_PSK=solo-para-mock-cambiar-por-openssl-rand-hex-32

# Rate limiting global por IP de cliente (plugin nativo `rate-limiting`).
# Aplica a toda la plataforma, no sólo a signup.
RATE_LIMIT_PER_MINUTE=60

# Techo de tamaño del body en la Route de signup (plugin `request-size-limiting`,
# en megabytes). El payload HPKE incluye una selfie comprimida en base64
# (~200KB); 5 deja margen. No puede superar el piso global de nginx
# (`nginx_http_client_max_body_size` en kong.conf, hoy 5m): si se sube este
# valor por encima de ese piso, nginx corta antes con su propio 413 y el
# plugin nunca llega a correr.
SIGNUP_MAX_BODY_MB=5

# ── Token Offloading ─────────────────────────────────────────────────────────
# Clave pública RSA de vinculo-vial-identity, con la que el Gateway verifica la
# firma RS256 de los JWT de sesión. Los saltos de línea van escapados como \n:
# el valor se inserta en un escalar YAML entrecomillado, que los interpreta.
# Para convertir un PEM a este formato:
#   awk 'BEGIN{ORS="\\n"} 1' identity-public.pem
# El valor de abajo es sólo un ejemplo para que el stack levante: reemplazar
# por la clave pública real de Identity.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAv86OLSaF1D2PGjRpk7ek\nGpPKXDpCCoQFrntN0tYywgjucgGy55hV+L/NioGhiBsheUmyoFfRlXzwt6e+WZzn\nTMlx+8poRwjyYI+z7QkMtwgRV+NLhOuoF23rxfr+lsOwFy2PLTvXtcEOIB59SH+u\nLhWDU4+7qwD3tCT1H2JMay8XaIDDcTPZiPFqVKV5oFfoP+0HBpjE5ObAzoraGBbH\nUanI9qo5vrvEKL0zbycbJ+cVsXOJc8y7eUcXnAruKPsOOkmnTdBnC61P1I2kXy3t\nRk2EIVVdGvCJsDm7E9/No5LA5UwL7toUTpRFAnSWW9jcFf49pc0pKwYOUgZpuoNE\nowIDAQAB\n-----END PUBLIC KEY-----
# Valor del claim `iss` de los JWT emitidos por Identity. Es la clave con la
# que Kong ubica el credencial del consumer.
JWT_ISSUER=vinculo-vial-identity

# ── Upstreams ────────────────────────────────────────────────────────────────
# URL interna de vinculo-vial-identity. El nombre de host es el del servicio en
# la red Docker compartida de la plataforma.
IDENTITY_SERVICE_URL=http://vinculo-vial-identity:8080
